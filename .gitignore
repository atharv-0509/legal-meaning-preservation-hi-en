# Source PDFs stay out of git (CLAUDE.md §7): download them from the URLs in sources.json (pdf_url).
data/raw/*.pdf

# Generated data IS tracked since the 19 Nov 2026 handover, so the project can be continued without
# re-running OCR, clause review, simplification and the 676 LLM annotations (see HANDOVER.md):
#   data/interim/ data/processed/ data/annotation/ data/splits/ data/ocr_cache/ modeling/runs/ reports/
# FrJUDGE is CC-BY-NC-SA 4.0: re-create with modeling/prepare_frjudge.py, never redistribute
data/splits_frjudge/
# baseline score caches (re-computed on demand) and the temporary bundle written by run_all.py push
modeling/cache/
modeling/kaggle/_splits.b64

# Secrets and local environment
.env
*.env
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
~$*.xlsx

# downloaded model checkpoints (large; fetch with kaggle_client.py fetch)
modeling/checkpoints/
# demo checkpoint downloaded from Kaggle (~1 GB); never commit
demo_model/
kaggle_output/

